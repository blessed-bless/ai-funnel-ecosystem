# Скопируй в .env и заполни. Без токена бот не стартует; API и CRM работают локально.

APP_NAME=AI Funnel Ecosystem
DATABASE_URL=sqlite+aiosqlite:///./data/aifunnel.db
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_URL=http://127.0.0.1:8080
CRM_API_TOKEN=dev-crm-token-change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MANAGER_URL=https://t.me/

# mock | openai_compat
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Ты консультант агентства автоматизации. Помогаешь квалифицировать лид: задача, бюджетный ориентир, контакт. Отвечай кратко по-русски. Не выдумывай цены и договоры.

FUNNEL_DEFAULT_SOURCE=direct
