# App
APP_NAME=AI Funnel Ecosystem
APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default; create ./data before first run
DATABASE_URL=sqlite+aiosqlite:///./data/aifunnel.db

# HTTP API
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# CRM API token (X-CRM-Token). Change before production.
CRM_API_TOKEN=dev-crm-token-change-me

# JWT login for HTML CRM / Bearer auth
JWT_SECRET=dev-jwt-secret-change-me-please-32b
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me

# Rate limits (per minute). Empty REDIS_URL → in-memory limiter.
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=

# Outbound webhooks from the outbox worker
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=8

# HTML CRM cookie session
CRM_COOKIE_NAME=aifunnel_session
CRM_PROTECT_HTML=true

# Telegram bot + manager notify
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MANAGER_URL=https://t.me/
TELEGRAM_MANAGER_CHAT_ID=

# AI: mock | openai-compatible
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_CIRCUIT_FAILURES=5
AI_CIRCUIT_RECOVERY_SECONDS=45

# Funnel defaults / readiness
FUNNEL_DEFAULT_SOURCE=direct
READY_REQUIRE_DB=true
